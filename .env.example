# LLM provider: claude-code (local dev, spawns the authenticated `claude` CLI)
# gemini, or groq (deployment, plain HTTPS; groq free tier needs no card).
LLM_PROVIDER=claude-code

# Required when LLM_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required when LLM_PROVIDER=groq. Free key (no card): https://console.groq.com
GROQ_API_KEY=

# Slice 3 (accounts + Postgres). All optional: unset = guest mode on localStorage.
# Neon Postgres connection string (pooled), e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=
# Auth.js session secret: generate with `npx auth secret`
AUTH_SECRET=
# GitHub OAuth app client id (https://github.com/settings/developers)
AUTH_GITHUB_ID=
# GitHub OAuth app client secret
AUTH_GITHUB_SECRET=
