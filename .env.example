# LLM provider: claude-code (local dev, spawns the authenticated `claude` CLI)
# gemini, or groq (deployment, plain HTTPS; groq free tier needs no card).
LLM_PROVIDER=claude-code

# Required when LLM_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required when LLM_PROVIDER=groq. Free key (no card): https://console.groq.com
GROQ_API_KEY=
